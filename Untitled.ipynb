
# Step 1: Import libraries
print("Step 1: Importing libraries...")

import numpy as np
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense

# Step 2: Load Shakespeare dataset
print("\nStep 2: Loading dataset...")

path = tf.keras.utils.get_file(
    "shakespeare.txt",
    "https://storage.googleapis.com/download.tensorflow.org/data/shakespeare.txt"
)

with open(path, "r", encoding="utf-8") as file:
    text = file.read()

text = text[:10000]

print("Total characters:", len(text))

# Step 3: Prepare character mappings
print("\nStep 3: Preparing text...")

chars = sorted(set(text))
char_to_index = {c: i for i, c in enumerate(chars)}
index_to_char = {i: c for i, c in enumerate(chars)}

print("Unique characters:", len(chars))

# Step 4: Create sequences and labels
print("\nStep 4: Creating sequences...")

seq_length = 40
sequences = []
labels = []

for i in range(len(text) - seq_length):
    seq = text[i:i + seq_length]
    label = text[i + seq_length]

    sequences.append([char_to_index[c] for c in seq])
    labels.append(char_to_index[label])

X = np.array(sequences)
y = np.array(labels)

X = tf.one_hot(X, len(chars))
y = tf.one_hot(y, len(chars))

print("Input shape:", X.shape)
print("Total sequences:", len(sequences))

# Step 5: Build the LSTM model
print("\nStep 5: Building LSTM model...")

model = Sequential([
    LSTM(50, input_shape=(seq_length, len(chars))),
    Dense(len(chars), activation="softmax")
])

model.summary()

# Step 6: Compile and train
print("\nStep 6: Training model...")

model.compile(
    optimizer="adam",
    loss="categorical_crossentropy",
    metrics=["accuracy"]
)

history = model.fit(
    X, y,
    epochs=20,
    batch_size=128,
    verbose=1
)

print("\nFinal Training Loss:",
      round(history.history["loss"][-1], 4))

print("Final Training Accuracy:",
      round(history.history["accuracy"][-1] * 100, 2), "%")

# Step 7: Generate text
print("\nStep 7: Generating text...")

start_seq = text[:seq_length]
generated_text = start_seq

for i in range(300):
    seq = generated_text[-seq_length:]

    x = np.array([[char_to_index[c] for c in seq]])
    x = tf.one_hot(x, len(chars))

    prediction = model.predict(x, verbose=0)[0]

    next_index = np.argmax(prediction)
    next_char = index_to_char[next_index]

    if i < 5:
        print(
            "Predicted character:", repr(next_char),
            "| Probability:", round(float(prediction[next_index]), 4)
        )

    generated_text += next_char

# Step 8: Display output
print("\nStep 8: Final Output")

print("\nStarting Text:")
print(start_seq)

print("\nGenerated Shakespeare Text:")
print(generated_text)
