
# Step 1: Import libraries
print("Step 1: Importing libraries...")

import numpy as np
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import SimpleRNN, Dense

# Step 2: Define text
print("Step 2: Loading text...")

text = "This is GeeksforGeeks a software training institute"

# Step 3: Create character mappings
print("Step 3: Creating character mappings...")

chars = sorted(set(text))
char_to_index = {c: i for i, c in enumerate(chars)}
index_to_char = {i: c for i, c in enumerate(chars)}

print("Unique characters:", len(chars))

# Step 4: Create sequences and labels
print("Step 4: Creating sequences...")

seq_length = 3
sequences = []
labels = []

for i in range(len(text) - seq_length):
    seq = text[i:i + seq_length]
    label = text[i + seq_length]

    sequences.append([char_to_index[c] for c in seq])
    labels.append(char_to_index[label])

X = np.array(sequences)
y = np.array(labels)

# Step 5: One-hot encoding
print("Step 5: Applying one-hot encoding...")

X = tf.one_hot(X, len(chars))
y = tf.one_hot(y, len(chars))

# Step 6: Build RNN model
print("Step 6: Building RNN model...")

model = Sequential([
    SimpleRNN(
        50,
        input_shape=(seq_length, len(chars)),
        activation="relu"
    ),
    Dense(len(chars), activation="softmax")
])

model.summary()

# Step 7: Compile model
print("Step 7: Compiling model...")

model.compile(
    optimizer="adam",
    loss="categorical_crossentropy",
    metrics=["accuracy"]
)

# Step 8: Train model
print("Step 8: Training model...")

history = model.fit(X, y, epochs=100, verbose=1)

print("Training Loss:", round(history.history["loss"][-1], 4))
print("Training Accuracy:",
      round(history.history["accuracy"][-1] * 100, 2), "%")

# Step 9: Generate text
print("Step 9: Generating text...")

start_seq = "This is G"
generated_text = start_seq

for i in range(50):
    seq = generated_text[-seq_length:]

    x = np.array([[char_to_index[c] for c in seq]])
    x = tf.one_hot(x, len(chars))

    prediction = model.predict(x, verbose=0)[0]

    next_index = np.argmax(prediction)
    next_char = index_to_char[next_index]

    generated_text += next_char

# Step 10: Display output
print("\nOriginal Text:")
print(text)

print("\nGenerated Text:")
print(generated_text)

print("\nPractical completed successfully!")
